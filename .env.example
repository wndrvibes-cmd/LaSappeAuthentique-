# ───────────────────────────────────────────────────────────────
#  CLIENT (exposé au navigateur — uniquement des clés publiques)
# ───────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhb...                 # clé « anon / publishable »
VITE_SITE_URL=http://localhost:5173

# Paiement — clé PUBLIABLE uniquement côté client
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ───────────────────────────────────────────────────────────────
#  SERVEUR — à définir comme « secrets » des Edge Functions
#  (supabase secrets set NOM=valeur) — JAMAIS dans le client
# ───────────────────────────────────────────────────────────────
# Moteur d'intelligence Nexscope (modules stratégiques)
ANTHROPIC_API_KEY=sk-ant-...

# Paiement
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Emails transactionnels
RESEND_API_KEY=re_...
SHOP_EMAIL_FROM="La Sappe Authentique <commandes@votredomaine.fr>"

# OPTIONNEL — données marché externes (veille prix / recherche produit)
# Sans ces clés, les modules concernés fonctionnent en saisie manuelle.
NEXSCOPE_API_KEY=
SERPAPI_KEY=

# Accès interne Supabase pour les Edge Functions (fourni automatiquement
# par la plateforme, à ne définir que pour un exécution locale)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
